# ==============================================================================
# STARPath Environment Configuration Template
# Copy this file to '.env' and adjust values as needed.
# NEVER commit your real '.env' file or API keys to any Git repository!
# ==============================================================================

# LLM Provider Options:
#   - "offline": 100% free, zero-key, zero-dependency local grounded synthesis (Default)
#   - "gemini":  Free online Google Gemini API (requires GEMINI_API_KEY)
#   - "ollama":  Free local open-source LLM via Ollama (requires Ollama running locally)
LLM_PROVIDER=offline

# Google Gemini API Settings (Free API key from https://aistudio.google.com)
# Leave blank when using LLM_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Settings (Optional)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# Retrieval Hyperparameters
TOP_K_CHUNKS=3
SIMILARITY_THRESHOLD=0.18

# Web Server Settings
HOST=0.0.0.0
PORT=8000
